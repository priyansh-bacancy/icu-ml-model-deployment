# Reconstructed from retained image history; not the lost original Dockerfile.
FROM python:3.12.14-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 YOLO_CONFIG_DIR=/tmp
ENV CUDA_MODULE_LOADING=LAZY NVIDIA_DRIVER_CAPABILITIES=compute,utility NVIDIA_VISIBLE_DEVICES=all
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg libgl1 libglib2.0-0 libgomp1 ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN python -m pip install --no-cache-dir uv==0.10.9
RUN uv pip install --system --no-cache torch==2.12.0 torchvision==0.27.0 \
    --index-url https://download.pytorch.org/whl/cu126
RUN uv pip install --system --no-cache fastapi==0.139.2 uvicorn==0.51.0 setuptools==80.9.0
WORKDIR /app
